<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Form</title>
</head>
<body>

<form>

    <label>FName:</label>
    <input type="text" name="fname">
    <br><br>

    <label>LName:</label>
    <input type="text" name="lname">
    <br><br>

    <label>Age:</label>
    <select name="age">
        <option>18</option>
        <option>19</option>
        <option>20</option>
        <option>21</option>
        <option>22</option>
        <option>23</option>
        <option>24</option>
        <option>25</option>
    </select>
    <br><br>

    <label>Sex:</label>
    <input type="radio" name="sex" value="female"> Female
    <input type="radio" name="sex" value="male"> Male
    <br><br>

    <label>Email:</label>
    <input type="email" name="email">
    <br><br>

    <input type="submit" value="Button">

</form>

</body>
</html>
